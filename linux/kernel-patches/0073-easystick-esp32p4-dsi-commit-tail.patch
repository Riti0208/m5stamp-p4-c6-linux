From: EasyStick Tab5 port
Subject: [PATCH] drm/esp32p4: arm DPI from commit tail (WHY2025 0033, code only)

WHY2025's 0033-drm-esp32p4-dsi-bringup-latency.patch at the locked
why2025-linux commit, without its hunk for the WHY2025 badge DTS, which
this tree does not carry.  The driver hunk is unchanged.

diff --git a/drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c b/drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c
index 6056daaa9..f067c4b5e 100644
--- a/drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c
+++ b/drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c
@@ -1273,15 +1273,12 @@ static void esp32p4_dsi_pipe_enable(struct drm_simple_display_pipe *pipe,
 	dsi->vfp_cache   = mode->vsync_start - mode->vdisplay;
 
 	/*
-	 * v5: 3 s delay instead of 400 ms. The late-enable work now programs
-	 * the bridge and performs the VIDEO-mode transition — it must fire
-	 * AFTER panel_bridge.enable completes, which runs after dw_bridge.
-	 * atomic_enable (~1.25 s) plus ST7703 .enable's init table (~50 ms)
-	 * + sleep_out wait (120 ms) + DISPLAY_ON — so completion ~1.4 s.
-	 * 3 s gives ~1.5 s margin. TODO: replace with a proper bridge-chain-
-	 * done hook once bring-up settles.
+	 * dpi_enable_work is armed from esp32p4_dsi_atomic_commit_tail()
+	 * once the bridge/panel enable chain has completed — see there.
+	 * (Replaced the v5 fixed 3 s timer that approximated the same
+	 * ordering; the timer's ~1.4 s completion estimate was stale
+	 * anyway, measured ~0.3 s on hardware.)
 	 */
-	schedule_delayed_work(&dsi->dpi_enable_work, msecs_to_jiffies(3000));
 }
 
 static void esp32p4_dsi_pipe_disable(struct drm_simple_display_pipe *pipe)
@@ -1493,6 +1490,35 @@ static const struct drm_mode_config_funcs esp32p4_dsi_mode_config_funcs = {
 	.atomic_commit	= drm_atomic_helper_commit,
 };
 
+/*
+ * Runs the default commit-tail, then arms the DPI/VIDEO enable work for
+ * any CRTC that just went through an enabling modeset. By the time
+ * drm_atomic_helper_commit_tail() returns, commit_modeset_enables() has
+ * run the whole bridge chain synchronously (PHY init, ST7703 reset +
+ * init table + sleep-out + DISPLAY_ON, DW host enable) — exactly the
+ * ordering pipe_enable's old fixed 3 s timer approximated, minus the
+ * dead time.
+ */
+static void esp32p4_dsi_atomic_commit_tail(struct drm_atomic_state *state)
+{
+	struct esp32p4_dsi *dsi = drm_to_esp32p4_dsi(state->dev);
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_crtc *crtc;
+	unsigned int i;
+
+	drm_atomic_helper_commit_tail(state);
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		if (new_crtc_state->active &&
+		    drm_atomic_crtc_needs_modeset(new_crtc_state))
+			schedule_delayed_work(&dsi->dpi_enable_work, 0);
+	}
+}
+
+static const struct drm_mode_config_helper_funcs esp32p4_dsi_mode_config_helpers = {
+	.atomic_commit_tail = esp32p4_dsi_atomic_commit_tail,
+};
+
 DEFINE_DRM_GEM_DMA_FOPS(esp32p4_dsi_drm_fops);
 
 static const struct drm_driver esp32p4_dsi_drm_driver = {
@@ -1526,6 +1552,7 @@ static int esp32p4_dsi_drm_init(struct esp32p4_dsi *dsi)
 	drm->mode_config.max_width  = 2048;
 	drm->mode_config.max_height = 2048;
 	drm->mode_config.funcs      = &esp32p4_dsi_mode_config_funcs;
+	drm->mode_config.helper_private = &esp32p4_dsi_mode_config_helpers;
 
 	/*
 	 * Stand up the display pipe: one primary plane (RGB565), one CRTC,
@@ -1738,10 +1765,17 @@ static int esp32p4_dsi_probe(struct platform_device *pdev)
 	 * but fbcon never attaches.
 	 *
 	 * Deferred to give the buddy heap time to settle past sensor probes
-	 * (BMI270 firmware upload over bit-banged I²C is the worst offender,
-	 * fragmenting memory enough that the 1 MB shadow vzalloc fails).
+	 * (the synchronous-at-probe attempt failed its 1 MB shadow vzalloc
+	 * amid the ~3.4 s deferred-probe/firmware-request churn). Measured
+	 * timeline: this probe lands at ~3.4 s, the BMI270 firmware attempts
+	 * fast-fail with -ENOENT by ~3.5 s (the real 8 KB upload happens at
+	 * patch 0009's ~8.5 s retry, which the old 6.5 s fbdev setup also
+	 * ran before), so 1 s (work fires ~4.5 s) clears the probe-time
+	 * churn — the original 3 s predates the measurement. Verify any
+	 * further cut with a freezetest campaign asserting fb0 appears:
+	 * the vzalloc failure mode is silent.
 	 */
-	schedule_delayed_work(&dsi->fbdev_setup_work, 3 * HZ);
+	schedule_delayed_work(&dsi->fbdev_setup_work, HZ);
 
 	/*
 	 * Start fbdev emulation so the kernel issues an initial atomic
