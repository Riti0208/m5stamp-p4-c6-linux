From: EasyStick Tab5 port
Subject: [PATCH] drm/panel: add Sitronix ST7123 (M5Stack Tab5)

720x1280 MIPI-DSI panel, two lanes, RGB565.  The init table and timings
are M5Stack's ESP-BSP values for the Tab5 as carried by Apache NuttX's
esp32p4-tab5 board.

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 407c5f6a2..532f85d4a 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -939,6 +939,14 @@ config DRM_PANEL_SITRONIX_ST7701
 	  ST7701 controller for 480X864 LCD panels with MIPI/RGB/SPI
 	  system interfaces.
 
+config DRM_PANEL_SITRONIX_ST7123
+	tristate "Sitronix ST7123 MIPI-DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	help
+	  Say Y here to enable the Sitronix ST7123 720x1280 MIPI-DSI panel
+	  used by the M5Stack Tab5.
+
 config DRM_PANEL_SITRONIX_ST7703
 	tristate "Sitronix ST7703 based MIPI touchscreen panels"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3615a761b..7d7e9dd90 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -96,6 +96,7 @@ obj-$(CONFIG_DRM_PANEL_SHARP_LS037V7DW01) += panel-sharp-ls037v7dw01.o
 obj-$(CONFIG_DRM_PANEL_SHARP_LS043T1LE01) += panel-sharp-ls043t1le01.o
 obj-$(CONFIG_DRM_PANEL_SHARP_LS060T1SX01) += panel-sharp-ls060t1sx01.o
 obj-$(CONFIG_DRM_PANEL_SITRONIX_ST7701) += panel-sitronix-st7701.o
+obj-$(CONFIG_DRM_PANEL_SITRONIX_ST7123) += panel-sitronix-st7123.o
 obj-$(CONFIG_DRM_PANEL_SITRONIX_ST7703) += panel-sitronix-st7703.o
 obj-$(CONFIG_DRM_PANEL_SITRONIX_ST7789V) += panel-sitronix-st7789v.o
 obj-$(CONFIG_DRM_PANEL_SUMMIT) += panel-summit.o
diff --git a/drivers/gpu/drm/panel/panel-sitronix-st7123.c b/drivers/gpu/drm/panel/panel-sitronix-st7123.c
new file mode 100644
index 000000000..f661c2fde
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7123.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sitronix ST7123 720x1280 MIPI-DSI panel (TDDI), as on the M5Stack Tab5.
+ *
+ * The init table and timings are the ones M5Stack's ESP-BSP uses for the
+ * Tab5 (disp_init_data_st7123), as carried by Apache NuttX's esp32p4-tab5
+ * board: two lanes at 1000 Mbps, RGB565, 70 MHz pixel clock.
+ *
+ * The panel reset is LCD_RST on an I2C IO expander that Linux does not
+ * drive; the boot shim releases it.  An optional reset-gpios is honoured
+ * for boards that wire it to a GPIO.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct st7123 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct st7123 *panel_to_st7123(struct drm_panel *panel)
+{
+	return container_of(panel, struct st7123, panel);
+}
+
+static void st7123_init_sequence(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x60, 0x71, 0x23, 0xa2);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x60, 0x71, 0x23, 0xa3);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x60, 0x71, 0x23, 0xa4);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa4, 0x31);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xd7,
+				     0x10, 0x0a, 0x10, 0x2a, 0x80, 0x80);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x90,
+				     0x71, 0x23, 0x5a, 0x20, 0x24, 0x09, 0x09);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa3,
+				     0x80, 0x01, 0x88, 0x30, 0x05, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x46, 0x00, 0x00, 0x1e,
+				     0x5c, 0x1e, 0x80, 0x00, 0x4f, 0x05, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x46, 0x00, 0x00,
+				     0x1e, 0x5c, 0x1e, 0x80, 0x00, 0x6f, 0x58,
+				     0x00, 0x00, 0x00, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa6,
+				     0x03, 0x00, 0x24, 0x55, 0x36, 0x00, 0x39,
+				     0x00, 0x6e, 0x6e, 0x91, 0xff, 0x00, 0x24,
+				     0x55, 0x38, 0x00, 0x37, 0x00, 0x6e, 0x6e,
+				     0x91, 0xff, 0x00, 0x24, 0x11, 0x00, 0x00,
+				     0x00, 0x00, 0x6e, 0x6e, 0x91, 0xff, 0x00,
+				     0xec, 0x11, 0x00, 0x03, 0x00, 0x03, 0x6e,
+				     0x6e, 0xff, 0xff, 0x00, 0x08, 0x80, 0x08,
+				     0x80, 0x06, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa7,
+				     0x19, 0x19, 0x80, 0x64, 0x40, 0x07, 0x16,
+				     0x40, 0x00, 0x44, 0x03, 0x6e, 0x6e, 0x91,
+				     0xff, 0x08, 0x80, 0x64, 0x40, 0x25, 0x34,
+				     0x40, 0x00, 0x02, 0x01, 0x6e, 0x6e, 0x91,
+				     0xff, 0x08, 0x80, 0x64, 0x40, 0x00, 0x00,
+				     0x40, 0x00, 0x00, 0x00, 0x6e, 0x6e, 0x91,
+				     0xff, 0x08, 0x80, 0x64, 0x40, 0x00, 0x00,
+				     0x00, 0x00, 0x20, 0x00, 0x6e, 0x6e, 0x84,
+				     0xff, 0x08, 0x80, 0x44);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xac,
+				     0x03, 0x19, 0x19, 0x18, 0x18, 0x06, 0x13,
+				     0x13, 0x11, 0x11, 0x08, 0x08, 0x0a, 0x0a,
+				     0x1c, 0x1c, 0x07, 0x07, 0x00, 0x00, 0x02,
+				     0x02, 0x01, 0x19, 0x19, 0x18, 0x18, 0x06,
+				     0x12, 0x12, 0x10, 0x10, 0x09, 0x09, 0x0b,
+				     0x0b, 0x1c, 0x1c, 0x07, 0x07, 0x03, 0x03,
+				     0x01, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xad,
+				     0xf0, 0x00, 0x46, 0x00, 0x03, 0x50, 0x50,
+				     0xff, 0xff, 0xf0, 0x40, 0x06, 0x01, 0x07,
+				     0x42, 0x42, 0xff, 0xff, 0x01, 0x00, 0x00,
+				     0xff, 0xff, 0xff, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xae,
+				     0xfe, 0x3f, 0x3f, 0xfe, 0x3f, 0x3f, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb2,
+				     0x15, 0x19, 0x05, 0x23, 0x49, 0xaf, 0x03,
+				     0x2e, 0x5c, 0xd2, 0xff, 0x10, 0x20, 0xfd,
+				     0x20, 0xc0, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe8,
+				     0x20, 0x6f, 0x04, 0x97, 0x97, 0x3e, 0x04,
+				     0xdc, 0xdc, 0x3e, 0x06, 0xfa, 0x26, 0x3e);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x75, 0x03, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe7,
+				     0x3b, 0x00, 0x00, 0x7c, 0xa1, 0x8c, 0x20,
+				     0x1a, 0xf0, 0xb1, 0x50, 0x00, 0x50, 0xb1,
+				     0x50, 0xb1, 0x50, 0xd8, 0x00, 0x55, 0x00,
+				     0xb1, 0x00, 0x45, 0xc9, 0x6a, 0xff, 0x5a,
+				     0xd8, 0x18, 0x88, 0x15, 0xb1, 0x01, 0x01,
+				     0x77);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xea,
+				     0x13, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00,
+				     0x2c);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0,
+				     0x22, 0x43, 0x11, 0x61, 0x25, 0x43, 0x43);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb7, 0x00, 0x00, 0x73, 0x73);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xbf, 0xa6, 0xaa);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa9,
+				     0x00, 0x00, 0x73, 0xff, 0x00, 0x00, 0x03,
+				     0x00, 0x00, 0x03);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc8,
+				     0x00, 0x00, 0x10, 0x1f, 0x36, 0x00, 0x5d,
+				     0x04, 0x9d, 0x05, 0x10, 0xf2, 0x06, 0x60,
+				     0x03, 0x11, 0xad, 0x00, 0xef, 0x01, 0x22,
+				     0x2e, 0x0e, 0x74, 0x08, 0x32, 0xdc, 0x09,
+				     0x33, 0x0f, 0xf3, 0x77, 0x0d, 0xb0, 0xdc,
+				     0x03, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc9,
+				     0x00, 0x00, 0x10, 0x1f, 0x36, 0x00, 0x5d,
+				     0x04, 0x9d, 0x05, 0x10, 0xf2, 0x06, 0x60,
+				     0x03, 0x11, 0xad, 0x00, 0xef, 0x01, 0x22,
+				     0x2e, 0x0e, 0x74, 0x08, 0x32, 0xdc, 0x09,
+				     0x33, 0x0f, 0xf3, 0x77, 0x0d, 0xb0, 0xdc,
+				     0x03, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x03);
+}
+
+static int st7123_prepare(struct drm_panel *panel)
+{
+	struct st7123 *ctx = panel_to_st7123(panel);
+
+	if (ctx->reset) {
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		usleep_range(10000, 11000);
+		gpiod_set_value_cansleep(ctx->reset, 0);
+		msleep(120);
+	}
+	return 0;
+}
+
+static int st7123_enable(struct drm_panel *panel)
+{
+	struct st7123 *ctx = panel_to_st7123(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	st7123_init_sequence(&dsi_ctx);
+	/* Sleep-out and display-on take no parameter on this controller. */
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00);
+	if (dsi_ctx.accum_err)
+		dev_err(&ctx->dsi->dev, "panel init failed: %d\n",
+			dsi_ctx.accum_err);
+	return dsi_ctx.accum_err;
+}
+
+static int st7123_disable(struct drm_panel *panel)
+{
+	struct st7123 *ctx = panel_to_st7123(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode st7123_mode = {
+	.clock		= 70000,
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 40,
+	.hsync_end	= 720 + 40 + 2,
+	.htotal		= 720 + 40 + 2 + 40,
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 220,
+	.vsync_end	= 1280 + 220 + 2,
+	.vtotal		= 1280 + 220 + 2 + 8,
+	.flags		= DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	.width_mm	= 62,
+	.height_mm	= 110,
+};
+
+static int st7123_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	struct st7123 *ctx = panel_to_st7123(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &st7123_mode);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+	return 1;
+}
+
+static enum drm_panel_orientation st7123_get_orientation(struct drm_panel *panel)
+{
+	return panel_to_st7123(panel)->orientation;
+}
+
+static const struct drm_panel_funcs st7123_funcs = {
+	.prepare	= st7123_prepare,
+	.enable		= st7123_enable,
+	.disable	= st7123_disable,
+	.get_modes	= st7123_get_modes,
+	.get_orientation = st7123_get_orientation,
+};
+
+static int st7123_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct st7123 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct st7123, panel, &st7123_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "cannot get reset gpio\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "cannot read orientation\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB565;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "mipi_dsi_attach failed\n");
+	}
+	return 0;
+}
+
+static void st7123_remove(struct mipi_dsi_device *dsi)
+{
+	struct st7123 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id st7123_of_match[] = {
+	{ .compatible = "sitronix,st7123" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, st7123_of_match);
+
+static struct mipi_dsi_driver st7123_driver = {
+	.probe	= st7123_probe,
+	.remove	= st7123_remove,
+	.driver = {
+		.name = "panel-sitronix-st7123",
+		.of_match_table = st7123_of_match,
+	},
+};
+module_mipi_dsi_driver(st7123_driver);
+
+MODULE_DESCRIPTION("Sitronix ST7123 MIPI-DSI panel driver");
+MODULE_LICENSE("GPL");
