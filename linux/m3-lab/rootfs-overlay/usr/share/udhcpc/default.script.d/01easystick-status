#!/bin/sh
# EasyStick udhcpc hook to update status.txt on IP assignment or renewal
# NOMMU-safe: zero subshells, zero pipes to prevent vfork issues in ash

ACTION="$1"

case "$ACTION" in
	bound|renew)
		# S40network records the config wpa_supplicant runs with:
		# credentials from config.txt use /run/wpa_cfg.conf.
		_conf=/tmp/wpa_supplicant.conf
		_c=""
		read -r _c < /run/.es-wpa-conf 2>/dev/null || true
		[ -n "$_c" ] && _conf=$_c
		_ssid="none"
		if [ -f "$_conf" ]; then
			while IFS= read -r line; do
				# ssid= only, not scan_ssid= or bssid=
				case "$line" in
					ssid=*|*[[:blank:]]ssid=*)
						_ssid="${line#*\"}"
						_ssid="${_ssid%\"*}"
						break
						;;
				esac
			done < "$_conf"
		fi
		[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "CONNECTED" "$ip" "$subnet" "$router" "$_ssid" "sta"
		# S40network leaves the NTP server here when the lease came after
		# its association timeout, so the clock is set now instead.
		_srv=""
		read -r _srv < /run/.es-ntp-pending 2>/dev/null || true
		if [ -n "$_srv" ]; then
			rm -f /run/.es-ntp-pending
			[ "$_srv" = none ] || ntpd -n -q -p "$_srv" >/dev/null 2>&1 &
		fi
		;;
	deconfig|leasefail)
		[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "DISCONNECTED" "none" "none" "none" "none" "sta"
		;;
esac

exit 0
