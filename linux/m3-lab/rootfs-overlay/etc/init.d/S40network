#!/bin/sh

# BusyBox ash in the RV32 NOMMU image does not implement `set -u`.
set -e

# Parsing helpers: tolerate a UTF-8 BOM, CRLF, spaces around "=" and comments.
conf_get() {
	bom=$(printf '\357\273\277')
	cr=$(printf '\r')
	sed -e "1s/^$bom//" -e "s/$cr\$//" "$2" 2>/dev/null |
		sed -n -e "s/^[ 	]*$1[ 	]*=[ 	]*//p" | head -n1
}

conf_ssid() {
	conf_get ssid "$1" | sed -e 's/^"//' -e 's/"[ 	]*$//'
}

# DHCP failed: do not invent a lab address or claim to be connected.
dhcp_failed() {
	local ssid=$(conf_ssid "$CONF")
	echo "M3-lab: DHCP failed"
	ifconfig wlan0 2>/dev/null || true
	[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "DHCP_FAILED" "none" "none" "none" "${ssid:-none}" "sta" &
	return 0
}


# Run udhcpc and wait for an address.  NOMMU BusyBox re-execs and daemonizes
# udhcpc unless -f is given, so the parent returns 0 before any lease exists.
# With -f in a background job the client keeps running and renews the lease.
run_dhcp() {
	udhcpc -f -i wlan0 -t 5 -T 3 >/dev/null 2>&1 &
	n=0
	while [ "$n" -lt 30 ]; do
		if ifconfig wlan0 2>/dev/null | grep 'inet addr:' | grep -vq 'inet addr:0\.0\.0\.0'; then
			return 0
		fi
		n=$((n + 1))
		sleep 1
	done
	return 1
}

# Start wpa_supplicant with $CONF; if it rejects the file (short psk, syntax
# error, BOM...), fall back to the built-in default so the board stays reachable.
start_wpa() {
	if wpa_supplicant -B -q -i wlan0 -c "$CONF"; then
		return 0
	fi
	echo "M3-lab: wpa_supplicant failed with $CONF; falling back to /etc/easystick/wpa_supplicant.conf"
	CONF=/etc/easystick/wpa_supplicant.conf
	wpa_supplicant -B -q -i wlan0 -c "$CONF" || echo "M3-lab: wpa_supplicant fallback failed"
}

# channel= (1-13) in config.txt overrides the SoftAP frequency (#24).  The
# source file may be on the exported drive, so edit a copy on /run.
apply_channel() {
	[ -f "$CFG" ] || return 0
	ch=$(conf_get channel "$CFG" | tr -d ' ')
	[ -n "$ch" ] || return 0
	case "$ch" in
		[1-9]|1[0-3]) ;;
		*) echo "M3-lab: ignoring invalid channel=$ch (expected 1-13)"; return 0 ;;
	esac
	freq=$((2407 + 5 * ch))
	if grep -q '^[[:space:]]*frequency=' "$CONF"; then
		sed "s/^\([[:space:]]*\)frequency=.*/\1frequency=$freq/" "$CONF" > /run/wpa_ap.conf
	else
		sed "s/^\([[:space:]]*\)mode=2.*/&\n\1frequency=$freq/" "$CONF" > /run/wpa_ap.conf
	fi
	chmod 600 /run/wpa_ap.conf
	CONF=/run/wpa_ap.conf
	echo "M3-lab: SoftAP channel $ch ($freq MHz)"
}

# wifi_ssid= / wifi_psk= in config.txt generate the Wi-Fi config so users do not
# have to write wpa_supplicant.conf (#25).  wifi_mode=ap makes it a SoftAP,
# otherwise a station.  Invalid values are reported and ignored.
config_wifi() {
	[ -f "$CFG" ] || return 0
	w_ssid=$(conf_get wifi_ssid "$CFG" | sed -e 's/^"//' -e 's/"[ 	]*$//')
	[ -n "$w_ssid" ] || return 0
	w_psk=$(conf_get wifi_psk "$CFG" | sed -e 's/^"//' -e 's/"[ 	]*$//')
	w_mode=$(conf_get wifi_mode "$CFG" | tr -d ' ')
	case "$w_ssid$w_psk" in
		*'"'*|*'\'*)
			echo "M3-lab: CONFIG ERROR: wifi_ssid/wifi_psk must not contain \" or \\; using $CONF"
			return 0 ;;
	esac
	if [ "${#w_ssid}" -gt 32 ]; then
		echo "M3-lab: CONFIG ERROR: wifi_ssid is longer than 32 bytes; using $CONF"
		return 0
	fi
	if [ -n "$w_psk" ] && { [ "${#w_psk}" -lt 8 ] || [ "${#w_psk}" -gt 63 ]; }; then
		echo "M3-lab: CONFIG ERROR: wifi_psk must be 8-63 characters; using $CONF"
		return 0
	fi
	if [ "$w_mode" = "ap" ] && [ -z "$w_psk" ]; then
		echo "M3-lab: CONFIG ERROR: wifi_mode=ap needs wifi_psk; using $CONF"
		return 0
	fi
	{
		echo "update_config=0"
		echo "ap_scan=1"
		echo "network={"
		printf '\tssid="%s"\n' "$w_ssid"
		if [ "$w_mode" = "ap" ]; then
			printf '\tmode=2\n\tfrequency=2437\n\tkey_mgmt=WPA-PSK\n\tproto=RSN\n'
			printf '\tpairwise=CCMP\n\tgroup=CCMP\n'
		elif [ -n "$w_psk" ]; then
			printf '\tscan_ssid=1\n\tkey_mgmt=WPA-PSK\n'
		else
			printf '\tscan_ssid=1\n\tkey_mgmt=NONE\n'
		fi
		[ -n "$w_psk" ] && printf '\tpsk="%s"\n' "$w_psk"
		echo "}"
	} > /run/wpa_cfg.conf
	chmod 600 /run/wpa_cfg.conf
	CONF=/run/wpa_cfg.conf
	echo "M3-lab: Wi-Fi config generated from config.txt (ssid=$w_ssid mode=${w_mode:-sta})"
}

# No RTC: set the clock once from NTP after a station lease (#25).  -q exits
# after the first sync so no daemon stays resident.  ntp_server= in config.txt
# overrides the pool; ntp_server=none disables it.
sync_time() {
	command -v ntpd >/dev/null 2>&1 || return 0
	srv=$(conf_get ntp_server "$CFG" | tr -d ' ')
	[ "$srv" = "none" ] && return 0
	( ntpd -n -q -p "${srv:-pool.ntp.org}" >/dev/null 2>&1 &&
		echo "M3-lab: clock set from NTP: $(date)" ) &
}

# udhcpd runs in the foreground under a respawn loop (#29): it comes back if
# it dies, and -f keeps NOMMU udhcpd from re-execing itself as a daemon.
UDHCPD_SUP=/run/.es-udhcpd-sup
stop_udhcpd() {
	if [ -f "$UDHCPD_SUP" ]; then
		kill "$(cat "$UDHCPD_SUP")" 2>/dev/null || true
		rm -f "$UDHCPD_SUP"
	fi
	killall udhcpd 2>/dev/null || true
}

start() {
	# Cmdline keeps loglevel=8 for bring-up captures, but console traffic at
	# that level still starves SDIO/ARP on this NOMMU target even after the
	# quiet ESP-Hosted patches (0024/0025).  Drop console printk now so the
	# lab SSH shot does not depend on a manual `dmesg -n 1` over ttyGS1.
	# debug=1 in config.txt raises the console to KERN_DEBUG for bring-up
	# captures (#26); expect slower Wi-Fi/SSH while it is on.
	if [ "$(conf_get debug /tmp/config.txt | tr -d ' ')" = "1" ]; then
		echo "M3-lab: debug=1: console loglevel 8 (all kernel messages)"
		dmesg -n 8 2>/dev/null || true
	else
		dmesg -n 4 2>/dev/null || true
	fi

	WANT_MHZ="${ES_SDIO_MHZ:-}"
	if [ -z "$WANT_MHZ" ] && [ -r /etc/easystick/sdio-clock-mhz ]; then
		WANT_MHZ=$(cat /etc/easystick/sdio-clock-mhz)
	fi
	WANT_MHZ="${WANT_MHZ:-5}"
	case "$WANT_MHZ" in
		1|2|5|10) ;;
		*) echo "ES_SDIO_CLOCK_FAIL invalid requested_mhz=$WANT_MHZ" >&2; exit 70 ;;
	esac
	MODULE_DIR="/lib/modules/$(uname -r)"
	KO="$MODULE_DIR/updates/esp32_sdio.ko"
	[ -f "$KO" ] || KO="$MODULE_DIR/extra/esp32_sdio.ko"
	if grep -q '^esp32_sdio ' /proc/modules; then
		echo "ES_SDIO_PRELOADED=1 requested_mhz=$WANT_MHZ (reusing loaded module)"
	else
		[ -f "$KO" ] || {
			echo "ES_SDIO_INSMOD_FAIL missing_ko=$KO requested_mhz=$WANT_MHZ" >&2
			exit 70
		}
		if insmod "$KO" "clockspeed=$WANT_MHZ"; then
			MODULE_SOURCE=S40
		else
			rc=$?
			echo "ES_SDIO_INSMOD_FAIL rc=$rc ko=$KO requested_mhz=$WANT_MHZ" >&2
			exit "$rc"
		fi
		[ -r /sys/module/esp32_sdio/parameters/clockspeed ] || {
			echo "ES_SDIO_CLOCK_FAIL module_param_unavailable source=$MODULE_SOURCE requested_mhz=$WANT_MHZ" >&2
			exit 70
		}
		ACTUAL_PARAM_MHZ=$(cat /sys/module/esp32_sdio/parameters/clockspeed)
		[ "$ACTUAL_PARAM_MHZ" = "$WANT_MHZ" ] || {
			echo "ES_SDIO_CLOCK_FAIL source=$MODULE_SOURCE requested_mhz=$WANT_MHZ module_param_mhz=$ACTUAL_PARAM_MHZ" >&2
			exit 70
		}
		MODULE_SHA256=$(sha256sum "$KO" 2>/dev/null)
		MODULE_SHA256=${MODULE_SHA256%% *}
		echo "ES_SDIO_LOAD_OK source=$MODULE_SOURCE requested_mhz=$WANT_MHZ module_param_mhz=$ACTUAL_PARAM_MHZ module_sha256=${MODULE_SHA256:-unavailable}"
	fi

	# S05 cached the initial configuration before exporting boot.img.  Runtime
	# updates are staged by easystick-bootsync only after a host SCSI eject;
	# never inspect the backing image from a network reload while it is exported.

	# Prefer /boot/wpa_supplicant.conf, then /tmp/wpa_supplicant.conf, then /etc/easystick
	CONF=/etc/easystick/wpa_supplicant.conf
	if [ -f /boot/wpa_supplicant.conf ]; then
		CONF=/boot/wpa_supplicant.conf
	elif [ -f /tmp/wpa_supplicant.conf ]; then
		CONF=/tmp/wpa_supplicant.conf
	fi

	# Also check config.txt to see if explicit wifi_mode or credentials were provided
	CFG=/etc/easystick/config.txt
	if [ -f /boot/config.txt ]; then
		CFG=/boot/config.txt
	elif [ -f /tmp/config.txt ]; then
		CFG=/tmp/config.txt
	fi
	config_wifi || true

	is_ap=0
	if [ -f "$CFG" ]; then
		cfg_mode=$(conf_get wifi_mode "$CFG" | tr -d ' ')
		cfg_host=$(conf_get hostname "$CFG" | tr -d ' ')
		if [ -n "$cfg_host" ]; then
			hostname "$cfg_host" 2>/dev/null || true
		fi
		if [ "$cfg_mode" = "ap" ]; then
			is_ap=1
		elif [ "$cfg_mode" = "sta" ]; then
			is_ap=0
		elif grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
			is_ap=1
		fi
	elif grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
		is_ap=1
	fi

	i=0
	while [ "$i" -lt 30 ]; do
		if ifconfig wlan0 >/dev/null 2>&1; then
			echo "M3-lab: wlan0 appeared"

			if [ "$is_ap" -eq 1 ]; then
				echo "M3-lab: starting SoftAP mode from $CONF"
				stop_udhcpd
				ifconfig wlan0 down 2>/dev/null || true
				iw dev wlan0 set type __ap 2>/dev/null || iw dev wlan0 set type ap 2>/dev/null || true
				ifconfig wlan0 192.168.4.1 netmask 255.255.255.0 up || true
				rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
				apply_channel || true
				start_wpa
				sleep 1
				if command -v udhcpd >/dev/null 2>&1; then
					mkdir -p /tmp /var/lib/misc
					touch /tmp/udhcpd.leases
					( while :; do udhcpd -f -S /etc/udhcpd.conf; sleep 2; done ) >/dev/null 2>&1 &
					echo $! > "$UDHCPD_SUP"
					echo "M3-lab: udhcpd started on wlan0 (192.168.4.1)"
				else
					echo "M3-lab: udhcpd not found"
				fi
				AP_SSID=$(conf_ssid "$CONF")
				echo "M3-lab: SoftAP started (SSID: ${AP_SSID:-m5}, IP: 192.168.4.1)"
				[ -x /etc/init.d/S85easystick-ssh ] && /etc/init.d/S85easystick-ssh restart &
				[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "AP_ACTIVE" "192.168.4.1" "255.255.255.0" "192.168.4.1" "${AP_SSID:-m5}" "ap" &
				return 0
			fi

			# STA / managed mode
			ifconfig wlan0 down 2>/dev/null || true
			iw dev wlan0 set type managed || true
			ifconfig wlan0 0.0.0.0 up || true
			rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
			start_wpa
			j=0
			while [ "$j" -lt 60 ]; do
				if iw dev wlan0 link 2>/dev/null | grep -q 'Connected'; then
					echo "M3-lab: association complete; configuring IPv4"
					if command -v udhcpc >/dev/null 2>&1; then
						if run_dhcp; then
							sync_time
						else
							dhcp_failed
						fi
					else
						dhcp_failed
					fi
					[ -x /etc/init.d/S85easystick-ssh ] && /etc/init.d/S85easystick-ssh restart &
					return 0
				fi
				j=$((j + 1))
				sleep 1
			done
			echo "M3-lab: wlan0 link status after timeout"
			iw dev wlan0 link 2>/dev/null || true
			ifconfig wlan0 2>/dev/null || true
			echo "M3-lab: wlan0 did not associate"
			sta_ssid=$(conf_ssid "$CONF")
			[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "DISCONNECTED" "none" "none" "none" "${sta_ssid:-none}" "sta" &
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	echo "M3-lab: wlan0 did not appear"
}

case "${1:-start}" in
	start) start ;;
	stop)
		stop_udhcpd
		killall wpa_supplicant udhcpc 2>/dev/null || true
		ifconfig wlan0 down 2>/dev/null || true
		rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
		[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "STOPPED" "none" "none" "none" "none" "none" &
		;;
	reload|restart)
		stop_udhcpd
		killall wpa_supplicant udhcpc 2>/dev/null || true
		ifconfig wlan0 down 2>/dev/null || true
		rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
		sleep 1
		start
		;;
	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac

exit 0
