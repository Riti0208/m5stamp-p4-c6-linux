# USB-A mass-storage configuration used by the M3-lab boot image.
# Keep this profile-local: production M3 does not expose boot.img.
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_MASS_STORAGE=m
CONFIG_USB_MASS_STORAGE=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# SHMEM depends on MMU, so on this NOMMU kernel "tmpfs" is always ramfs:
# size= is ignored and /tmp, /run are uncapped (#17).  SHMEM and TMPFS_XATTR
# used to be set here; Kconfig silently dropped both.  /tmp is therefore an
# ext2 filesystem on a 2 MB brd ramdisk instead: brd allocates pages only
# when they are written, and the device size caps what /tmp can pin.
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=2048
CONFIG_EXT2_FS=y
# The overlay upper dirs live on that ext2 /tmp; without xattrs overlayfs
# cannot store trusted.overlay.* (opaque dirs, whiteouts) and warns (#12).
CONFIG_EXT2_FS_XATTR=y
# Multicast receive for the mDNS responder (#25).
CONFIG_IP_MULTICAST=y
