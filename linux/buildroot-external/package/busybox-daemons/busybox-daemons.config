# Merged over allnoconfig, then resolved with oldconfig.  Settings and applet
# features match the main m3-lab BusyBox for these four applets.
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_PID_FILE_PATH=""
CONFIG_FEATURE_SYSLOG=y
CONFIG_FEATURE_SYSLOG_INFO=y
CONFIG_STATIC=y
CONFIG_NOMMU=y
CONFIG_STATIC_LIBGCC=y
CONFIG_NO_DEBUG_LIB=y
# The daemons are exec()ed by init and inetd; no shell is needed.
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_SHELL_HUSH is not set
# CONFIG_SHELL_ASH is not set
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_MONOTONIC_SYSCALL=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_KILL_REMOVED=y
CONFIG_FEATURE_KILL_DELAY=0
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_SYSLOG=y
CONFIG_FEATURE_INIT_QUIET=y
CONFIG_INIT_TERMINAL_TYPE="linux"
CONFIG_FEATURE_INIT_MODIFY_CMDLINE=y
CONFIG_INETD=y
CONFIG_SYSLOGD=y
CONFIG_FEATURE_ROTATE_LOGFILE=y
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=256
CONFIG_UDHCPD=y
CONFIG_FEATURE_UDHCPD_BOOTP=y
CONFIG_FEATURE_UDHCPD_BASE_IP_ON_MAC=y
CONFIG_FEATURE_UDHCPD_WRITE_LEASES_EARLY=y
CONFIG_DHCPD_LEASES_FILE=""
