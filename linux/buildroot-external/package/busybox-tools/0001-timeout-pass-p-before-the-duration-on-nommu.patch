timeout: pass -p before the duration when re-executing on NOMMU

The NOMMU re-exec put -pPID after TIMEOUT, but getopt32 stops at the
first non-option ("+"), so -p was never parsed: the watcher was never
created and "timeout 1 sleep 5" ran for 5 s and exited 0.

Upstream-Status: Pending

--- a/coreutils/timeout.c
+++ b/coreutils/timeout.c
@@ -123,11 +123,21 @@
 		/* Child: spawn grandchild and exit */
 		parent = getppid();
 #if !BB_MMU
-		argv[optind] = xasprintf("-p%u", parent);
-		argv[optind + 1] = NULL;
-#endif
+		/* getopt32 stops at the first non-option, so -p must come
+		 * before TIMEOUT: re-exec as "timeout [OPTS] -pPID TIMEOUT PROG".
+		 * Build a new vector: argv is shared with the vforked parent.
+		 */
+		char **nv = xzalloc((optind + 3) * sizeof(nv[0]));
+		memcpy(nv, argv, (optind - 1) * sizeof(nv[0]));
+		nv[optind - 1] = xasprintf("-p%u", parent);
+		nv[optind] = argv[optind - 1];
+		nv[optind + 1] = argv[optind];
+		/* NB: exits with nonzero on error: */
+		bb_daemonize_or_rexec(0, nv);
+#else
 		/* NB: exits with nonzero on error: */
 		bb_daemonize_or_rexec(0, argv);
+#endif
 		/* Here we are grandchild. Sleep, then kill grandparent */
  grandchild:
 		if (timeout_wait(timeout, parent) == EXIT_SUCCESS)
